# 카페24(Apache) 웹호스팅 설정. `npm run build` 하면 dist/ 에 함께 복사됩니다.
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # http → https (카페24 SSL 적용 후. 무한 새로고침이 생기면 이 두 줄을 지우세요)
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # www.crosslesson.com → crosslesson.com
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # ---- 예전 PHP 주소 → 새 주소 (검색 순위 유지용 301) ----
  RewriteCond %{QUERY_STRING} (?:^|&)no=([0-9]+)
  RewriteRule ^lesson\.php$ /lesson/%1? [R=301,L]
  RewriteCond %{QUERY_STRING} (?:^|&)d=([0-9]+)
  RewriteRule ^class\.php$ /?teach=%1 [R=301,L]
  RewriteCond %{QUERY_STRING} (?:^|&)d=([0-9]+)
  RewriteRule ^learn\.php$ /?learn=%1 [R=301,L]
  RewriteRule ^about\.php$ /about [R=301,L]
  RewriteRule ^(?:index\.php|lesson\.php|class\.php|learn\.php)$ / [R=301,L]

  # ---- React 화면 주소: 실제 파일이 아니면 index.html 을 돌려줍니다 ----
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # index.html 은 항상 새로 받고, 파일명에 해시가 붙은 assets/ 는 1년 캐시
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css|svg|png|jpg|webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
