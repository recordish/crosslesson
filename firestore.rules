rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function isStr(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function isTime(v) { return v is int && v > 0; }

    // src/data/categories.js 의 SIDO 와 같아야 합니다 ('' = 지정 안 함)
    function isSido(v) {
      return v in ['', '서울', '경기', '인천', '부산', '대구', '광주', '대전', '울산', '세종',
                   '강원', '충북', '충남', '전북', '전남', '경북', '경남', '제주', '해외'];
    }
    function isAge(v) { return v == null || (v is int && v >= 10 && v <= 99); }
    function isCategory(v) { return v is int && v >= 100 && v <= 999; }
    // src/data/lessonOptions.js 와 같아야 합니다
    // 배울 과목 0~3개 (0개는 예전 사이트에서 옮겨 온 "가르쳐 주기만" 하는 글)
    function isLearns(v) {
      return v is list && v.size() <= 3 && v.toSet().size() == v.size()
        && (v.size() < 1 || isCategory(v[0]))
        && (v.size() < 2 || isCategory(v[1]))
        && (v.size() < 3 || isCategory(v[2]));
    }
    function isSubset(v, allowed) { return v is list && v.size() <= allowed.size() && v.toSet().size() == v.size() && v.toSet().hasOnly(allowed); }
    function isDays(v) { return isSubset(v, ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun']); }
    function isTimeSlots(v) { return isSubset(v, ['morning', 'afternoon', 'evening']); }
    function isTeachLevel(v) { return v in ['', 'hobby', 'skilled', 'pro']; }
    function isLearnLevel(v) { return v in ['', 'beginner', 'basic', 'intermediate']; }

    // ---------- 회원 프로필 ----------
    // 누구나 읽을 수 있고(닉네임·소개), 본인만 씁니다.
    match /users/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['nickname', 'intro', 'createdAt', 'updatedAt'])
        && isStr(request.resource.data.nickname, 2, 12)
        && isStr(request.resource.data.intro, 0, 300)
        && isTime(request.resource.data.createdAt)
        && isTime(request.resource.data.updatedAt);
      allow delete: if signedIn() && me() == uid;
    }

    // ---------- 레슨 번호 카운터: counters/lessons = { last } ----------
    // 새 레슨을 만들 때만, 같은 트랜잭션 안에서 정확히 1씩 늘릴 수 있습니다.
    match /counters/lessons {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last == 1
        && existsAfter(/databases/$(database)/documents/lessons/1);
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last == resource.data.last + 1
        && existsAfter(/databases/$(database)/documents/lessons/$(string(request.resource.data.last)));
    }

    // ---------- 레슨: lessons/{no} ----------
    match /lessons/{lessonId} {
      function counterPath() { return /databases/$(database)/documents/counters/lessons; }
      function lessonKeys() {
        return ['no', 'uid', 'authorName', 'teach', 'learns', 'teachLevel', 'learnLevel',
                'online', 'offline', 'sido', 'region', 'days', 'timeSlots', 'ageMin', 'ageMax',
                'content', 'closed', 'views', 'createdAt', 'updatedAt'];
      }
      function editable(d) {
        // 가르칠 과목이 없거나(null) 배울 과목이 없는 건 예전 글뿐입니다. 둘 중 하나는 꼭 있어야 합니다.
        return (d.teach == null || isCategory(d.teach)) && isLearns(d.learns)
          && (d.teach != null || d.learns.size() > 0)
          && isTeachLevel(d.teachLevel) && isLearnLevel(d.learnLevel)
          && d.online is bool && d.offline is bool && (d.online || d.offline)
          && isSido(d.sido) && (d.offline || d.sido == '')
          && isStr(d.region, 0, 40)
          && isDays(d.days) && isTimeSlots(d.timeSlots)
          && isAge(d.ageMin) && isAge(d.ageMax)
          && (d.ageMin == null || d.ageMax == null || d.ageMin <= d.ageMax)
          && isStr(d.content, 10, 3000)
          && d.closed is bool
          && isStr(d.authorName, 2, 12)
          && isTime(d.updatedAt);
      }

      allow read: if true;

      // 번호(no)는 카운터 다음 번호여야 하고, 같은 트랜잭션에서 카운터가 그 번호로 바뀌어야 합니다.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(lessonKeys())
        && request.resource.data.uid == me()
        && request.resource.data.no == int(lessonId)
        && request.resource.data.no == (exists(counterPath()) ? get(counterPath()).data.last + 1 : 1)
        && getAfter(counterPath()).data.last == request.resource.data.no
        && request.resource.data.views == 0
        && isTime(request.resource.data.createdAt)
        && editable(request.resource.data);

      // 작성자 수정: 번호·작성자·조회수·작성일은 못 바꿉니다.
      allow update: if signedIn() && resource.data.uid == me()
        && !changed().hasAny(['no', 'uid', 'views', 'createdAt'])
        && request.resource.data.keys().hasOnly(lessonKeys())
        && editable(request.resource.data);

      // 누구나 조회수만 1씩 올릴 수 있습니다.
      allow update: if changed().hasOnly(['views'])
        && request.resource.data.views == resource.data.views + 1;

      allow delete: if signedIn() && resource.data.uid == me();
    }

    // ---------- 신청: applications/{lessonNo}_{applicantUid} ----------
    match /applications/{appId} {
      function lessonOf(no) { return get(/databases/$(database)/documents/lessons/$(string(no))).data; }
      function isMine() { return appId.split('_')[1] == me(); }

      // 하나씩 읽기: 신청자, 레슨 작성자. (내 신청이 없는지 확인하는 것도 허용)
      allow get: if signedIn()
        && (isMine() || resource.data.applicantUid == me() || resource.data.lessonOwnerUid == me());
      // 목록: 내가 보낸 신청 또는 내 레슨에 온 신청만
      allow list: if signedIn()
        && (resource.data.applicantUid == me() || resource.data.lessonOwnerUid == me());

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['lessonNo', 'lessonOwnerUid', 'lessonTeach', 'lessonLearns',
             'applicantUid', 'applicantName', 'message', 'status', 'reply', 'createdAt', 'updatedAt'])
        && appId == string(request.resource.data.lessonNo) + '_' + me()
        && request.resource.data.applicantUid == me()
        && request.resource.data.lessonOwnerUid == lessonOf(request.resource.data.lessonNo).uid
        && request.resource.data.lessonOwnerUid != me()
        && lessonOf(request.resource.data.lessonNo).closed == false
        && request.resource.data.lessonTeach == lessonOf(request.resource.data.lessonNo).teach
        && request.resource.data.lessonLearns == lessonOf(request.resource.data.lessonNo).learns
        && isStr(request.resource.data.applicantName, 2, 12)
        && isStr(request.resource.data.message, 5, 1000)
        && request.resource.data.status == 'pending'
        && request.resource.data.reply == ''
        && isTime(request.resource.data.createdAt)
        && isTime(request.resource.data.updatedAt);

      // 레슨 작성자: 수락/거절과 답장만
      allow update: if signedIn() && resource.data.lessonOwnerUid == me()
        && changed().hasOnly(['status', 'reply', 'updatedAt'])
        && request.resource.data.status in ['accepted', 'rejected']
        && isStr(request.resource.data.reply, 0, 1000)
        && isTime(request.resource.data.updatedAt);

      // 신청자: 취소. 레슨 작성자: 탈퇴하거나 레슨을 지울 때 받은 신청 정리
      allow delete: if signedIn() && (resource.data.applicantUid == me() || resource.data.lessonOwnerUid == me());
    }

    // ---------- 관리자 ----------
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(me())); }

    // admins/{uid}: 본인이 관리자인지만 확인할 수 있고, 쓰기는 서버(관리 스크립트)에서만
    match /admins/{uid} {
      allow get: if signedIn() && me() == uid;
    }

    // ---------- 회원 기록 (비공개) ----------
    // members/{uid} = { email, joinedAt, lastLoginAt }: 본인이 로그인할 때 남기고, 본인과 관리자만 읽습니다.
    match /members/{uid} {
      allow get: if signedIn() && (me() == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['email', 'joinedAt', 'lastLoginAt'])
        && request.resource.data.email == request.auth.token.email
        && isTime(request.resource.data.joinedAt)
        && isTime(request.resource.data.lastLoginAt);
      allow delete: if signedIn() && me() == uid;
    }

    // ---------- 알림 메일 설정 ----------
    // emailPrefs/{uid} = { off, updatedAt }: 본인만 읽고 씁니다 (메일 발송 스크립트는 서버 권한으로 읽음)
    match /emailPrefs/{uid} {
      allow get, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['off', 'updatedAt'])
        && request.resource.data.off is bool
        && isTime(request.resource.data.updatedAt);
    }

    // ---------- 접속 기록 ----------
    // 누구나 한 건씩 남길 수 있고(형식 검사), 관리자만 읽습니다. 고칠 수 없고,
    // 5년이 지난 기록만 관리자가 지울 수 있습니다 (관리자 페이지를 열 때 자동 정리).
    match /visits/{id} {
      allow read: if isAdmin();
      allow delete: if isAdmin() && resource.data.t < request.time.toMillis() - 157680000000;
      allow create: if request.resource.data.keys().hasOnly(['t', 'vid', 'sid', 'entry', 'newVisitor', 'path',
             'ref', 'refPath', 'source', 'medium', 'campaign', 'lang', 'tz', 'country', 'device', 'os', 'browser',
             'app', 'signedIn', 'uid', 'expireAt'])
        && request.resource.data.t is int
        && request.resource.data.t > request.time.toMillis() - 600000
        && request.resource.data.t < request.time.toMillis() + 600000
        && isStr(request.resource.data.vid, 1, 40)
        && isStr(request.resource.data.sid, 1, 40)
        && request.resource.data.entry is bool
        && request.resource.data.newVisitor is bool
        && isStr(request.resource.data.path, 1, 200)
        && isStr(request.resource.data.ref, 0, 100)
        && isStr(request.resource.data.refPath, 0, 200)
        && isStr(request.resource.data.source, 0, 100)
        && isStr(request.resource.data.medium, 0, 100)
        && isStr(request.resource.data.campaign, 0, 100)
        && isStr(request.resource.data.lang, 0, 20)
        && isStr(request.resource.data.tz, 0, 50)
        && isStr(request.resource.data.country, 0, 2)
        && request.resource.data.device in ['mobile', 'tablet', 'desktop']
        && isStr(request.resource.data.os, 1, 20)
        && isStr(request.resource.data.browser, 1, 30)
        && request.resource.data.app is bool
        && request.resource.data.signedIn is bool
        && (request.resource.data.get('uid', '') == '' || (signedIn() && request.resource.data.uid == me()))
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt < request.time + duration.value(1860, 'd');
    }
  }
}
